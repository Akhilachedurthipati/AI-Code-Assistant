# Backend environment variables (do NOT commit a file named .env with real secrets)
# Copy this file to `.env` and fill in real values locally or in your host's secret UI.

# Database type: "sqlite" (default, zero-config local file), "mysql" (production server), or "none" (completely stateless, uses frontend localStorage fallback)
DB_TYPE=sqlite

# MySQL connection settings (only required if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_code_assistant

# Alternatively, define a single connection URL (e.g. from Railway or another cloud provider)
# DATABASE_URL=mysql+pymysql://user:password@host:port/database
# or for SQLite: DATABASE_URL=sqlite:///./ai_code_assistant.db

# OpenAI API key (keep secret, do NOT expose to frontend)
OPENAI_API_KEY=your_openai_api_key_here

# Alternatively, Google Gemini API key (offers a generous free tier for developer use)
# Get a free key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here


